# Pin a release tag or digest in production; do not deploy floating latest.
NCG_IMAGE=ghcr.io/abingooo/nocyber-guard@sha256:d2b66c7d1a112d56b480b98f3a9436264b8b57cc3e1faed0ad5107aee2d0967c
NCG_CONTAINER_NAME=nocyber-guard

NCG_UPSTREAM_URL=http://sub2api:8080
NCG_NETWORK_NAME=sub2api-network
NCG_NETWORK_EXTERNAL=true

NCG_BIND_HOST=127.0.0.1
NCG_PROXY_PORT=18086
NCG_ADMIN_BIND_HOST=127.0.0.1
NCG_ADMIN_PORT=19090
NCG_DATA_PATH=./data

# Generate separately; never commit populated values. Use these direct values
# OR the Docker secrets override documented in deploy/README.md, never both.
NCG_MASTER_KEY=replace-with-openssl-rand-hex-32
NCG_INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
NCG_TRUSTED_PROXY_CIDRS=

NCG_AUDIT_BODY_LIMIT=4194304
NCG_AI_CONCURRENCY=16
NCG_AI_TIMEOUT=15s
NCG_AI_QUEUE_TIMEOUT=2s
NCG_ADMIN_COOKIE_SECURE=false
TZ=Asia/Shanghai
