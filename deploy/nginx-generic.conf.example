# Include nginx-http-common.conf.example once from http{} before this file.
# Replace the existing public gateway upstream with this server block's
# locations. Keep the upstream service private; only Guard is public-facing.
upstream nocyber_guard_proxy {
    server 127.0.0.1:18086 max_fails=2 fail_timeout=10s;
}

server {
    listen 443 ssl http2;
    server_name api.example.com;
    client_max_body_size 256m;

    # Model generation is non-idempotent. Never retry/replay a POST.
    location = /v1/responses {
        proxy_pass http://nocyber_guard_proxy;
        proxy_next_upstream off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nocyber_connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Other routes, including the UI, are transparent through Guard.
    location / {
        proxy_pass http://nocyber_guard_proxy;
        proxy_next_upstream off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nocyber_connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
