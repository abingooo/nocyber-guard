# ModelPort/tianliyun cutover example. Include
# nginx-http-common.conf.example once from nginx's http{} context.
# Existing public app: 18080; pinned official app: 18085;
# Guard data plane: 18087; image-site: 18183.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name modelport.link;
    client_max_body_size 256m;

    # Keep the existing certificate, ACME, and branding locations unchanged.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
    }
    location ^~ /brand/ {
        root /var/www/modelport;
        try_files $uri =404;
    }
    location = /favicon.ico {
        alias /var/www/modelport/brand/modelport-favicon.ico;
    }

    # Image API calls are non-idempotent. Never retry or replay them.
    # Reject the invalid no-slash form instead of redirecting a POST and
    # asking the client to replay a non-idempotent request.
    location = /image/api-proxy { return 404; }
    location ^~ /image/api-proxy/ {
        # The trailing slash intentionally strips /image/api-proxy/ so Guard
        # and the official app receive the original API path (for example,
        # /v1/images/generations). Query parameters are preserved.
        proxy_pass http://127.0.0.1:18087/;
        proxy_next_upstream off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Static image UI remains on the existing image-site container.
    location = /image { return 301 /image/; }
    location ^~ /image/ {
        proxy_pass http://127.0.0.1:18183;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # UI, auth, API, SSE, and WS traffic transparently reaches official app
    # through Guard. The explicit image API location above prevents a bypass.
    location / {
        proxy_pass http://127.0.0.1:18087;
        proxy_next_upstream off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nocyber_connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
