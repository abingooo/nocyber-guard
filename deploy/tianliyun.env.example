# tianliyun: official ModelPort/Sub2API rehearsal topology.
NCG_IMAGE=ghcr.io/abingooo/nocyber-guard@sha256:594567c791d8d305d72392609504f2c4f9ff7a54c68437d286eda37e44d0f094
NCG_CONTAINER_NAME=nocyber-guard
NCG_UPSTREAM_URL=http://app:8080
NCG_NETWORK_NAME=modelport-next-egress
NCG_NETWORK_EXTERNAL=true

NCG_BIND_HOST=127.0.0.1
NCG_PROXY_PORT=18087
NCG_ADMIN_BIND_HOST=127.0.0.1
NCG_ADMIN_PORT=19090
NCG_DATA_PATH=/data/nocyber-guard/data

# Nginx on tianliyun connects to the published port. Docker's userland proxy
# appears to Guard as the egress-network gateway; keep this single host narrow.
NCG_TRUSTED_PROXY_CIDRS=172.21.0.1/32
# Use these direct values OR deploy/docker-compose.secrets.yml.example, never
# both. Delete both direct-value lines when enabling the secrets override.
NCG_MASTER_KEY=replace-with-openssl-rand-hex-32
NCG_INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
NCG_AUDIT_BODY_LIMIT=4194304
NCG_AI_CONCURRENCY=16
NCG_AI_TIMEOUT=15s
NCG_AI_QUEUE_TIMEOUT=2s
NCG_ADMIN_COOKIE_SECURE=false
TZ=Asia/Shanghai
