NCG_UPDATER_SOCKET=/run/nocyber-updater/updater.sock
NCG_UPDATER_SOCKET_GID=65532
NCG_UPDATER_COMPOSE_DIR=/opt/nocyber-guard-main
NCG_UPDATER_COMPOSE_FILE=/opt/nocyber-guard-main/docker-compose.yml
NCG_UPDATER_COMPOSE_OVERRIDE=/opt/nocyber-guard-main/docker-compose.updater.yml
NCG_UPDATER_ENV_FILE=/opt/nocyber-guard-main/.env
NCG_UPDATER_SERVICE=guard
NCG_UPDATER_HEALTH_URL=http://127.0.0.1:18087/_nocyber/readyz
NCG_UPDATER_STATE_FILE=/var/lib/nocyber-updater/state.json
