# ZeusA: use the existing proxy/upstream network, not a database network.
NCG_IMAGE=ghcr.io/abingooo/nocyber-guard:v0.1.0
NCG_CONTAINER_NAME=nocyber-guard
NCG_UPSTREAM_URL=http://zeus-sub2api:8080
NCG_NETWORK_NAME=zeuszs_upstreams
NCG_NETWORK_EXTERNAL=true

NCG_BIND_HOST=127.0.0.1
NCG_PROXY_PORT=18086
NCG_ADMIN_BIND_HOST=127.0.0.1
NCG_ADMIN_PORT=19090
NCG_DATA_PATH=/opt/nocyber-guard/data

# Current Caddy address on zeuszs_upstreams is 172.18.0.4. Re-check after
# container recreation and keep this to the single proxy address.
NCG_TRUSTED_PROXY_CIDRS=172.18.0.4/32
# Use these direct values OR deploy/docker-compose.secrets.yml.example, never
# both. Delete both direct-value lines when enabling the secrets override.
NCG_MASTER_KEY=replace-with-openssl-rand-hex-32
NCG_INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
NCG_AUDIT_BODY_LIMIT=4194304
NCG_AI_CONCURRENCY=16
NCG_AI_TIMEOUT=15s
NCG_AI_QUEUE_TIMEOUT=2s
NCG_ADMIN_COOKIE_SECURE=false
TZ=Asia/Shanghai
